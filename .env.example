AGENT_WRAPPER_PORT=3003
CHAT_INTERFACE_PORT=3004

# Service URLs
TARGET_APP_URL=http://localhost:3001
AUTH0_GATE_URL=http://localhost:3002
AGENT_WRAPPER_URL=http://localhost:3003

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ (optional)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
