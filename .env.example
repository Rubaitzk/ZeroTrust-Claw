# Example environment variables for ZeroTrust-Claw

# Discord bot
DISCORD_TOKEN=MTQ5MDcxMDQ5ODg5Mzc2MjY5Mw.GGfaul.WnC0am338sUobkOXaWyJnsChK7UAWcC3fshUy8

# Auth0 gateway
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
